[Unit]
Description=Proton Download Box – Keyring-Session (D-Bus + SecretService)
After=dbus.service
Before=proton-download-box.service

[Service]
Type=simple
User=proton
Group=proton
Environment=HOME=/home/proton
RuntimeDirectory=pdb-keyring
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/pdb-keyring-session
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target