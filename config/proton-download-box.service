[Unit]
Description=Proton Download Box (FastAPI + React web UI)
Documentation=https://github.com/HatchetMan111/DownLoader
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
# LXC-safe: läuft als root im (unprivilegierten) Container – wie xrdp/NM/smbd
# dort auch. Mount-namespace-Hardening (ProtectSystem/PrivateTmp) kann in
# unprivilegierten LXC 203/EXEC verursachen und ist deshalb bewusst weggelassen;
# die Isolation übernimmt der Container.
EnvironmentFile=/etc/proton-download-box.env
WorkingDirectory=/opt/proton-download-box
ExecStart=/opt/proton-download-box/venv/bin/python /opt/proton-download-box/backend/main.py
Restart=always
RestartSec=3
TimeoutStopSec=15

# Sicher ohne Namespace-Mechanik: keine Privilegien-Eskalation aus dem Prozess.
NoNewPrivileges=yes
UMask=0022

StandardOutput=journal
StandardError=journal
SyslogIdentifier=proton-download-box

[Install]
WantedBy=multi-user.target
